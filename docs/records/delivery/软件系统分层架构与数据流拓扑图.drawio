        <mxCell id="box_core_4" value="&lt;b&gt;筒身网格理论&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#000000&quot;&gt;螺旋与环向承载叠加&lt;br/&gt;爆破压力与层数估算&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12.5;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei,SimSun,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="704" y="611" width="190" height="96" as="geometry" />
        </mxCell>
        <mxCell id="box_core_5" value="&lt;b&gt;封头厚度与爆压校核&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#000000&quot;&gt;三次样条厚度拟合&lt;br/&gt;封头母线爆压校核&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12.5;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei,SimSun,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="914" y="611" width="190" height="96" as="geometry" />
        </mxCell>

        <!-- ══════════════ 5. 数据流连接线（95px 垂直高空走廊 + 240px 水平宽敞通道） ══════════════ -->

        <!-- 连线 1：输入设计参数 / 调整铺层 (垂直向下直线，95px 长度，上下留白各约 35px) -->
        <mxCell id="flow_input" value="输入设计参数 / 调整铺层" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=10.5;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei,SimSun,sans-serif;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
