        <!-- 连线 5：返回计算与校核结果 (垂直向上直线，与连线 4 横向间隔 188px，互不干扰) -->
        <mxCell id="flow_core_out" value="返回计算与校核结果" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=10.5;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei,SimSun,sans-serif;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="565" as="sourcePoint" />
            <mxPoint x="380" y="470" as="targetPoint" />
