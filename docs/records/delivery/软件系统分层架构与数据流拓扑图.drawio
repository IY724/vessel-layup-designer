        <mxCell id="layer_export_title" value="报表导出层（Export Engine）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;fontColor=#000000;fontFamily=Microsoft YaHei,SimSun,sans-serif;" vertex="1" parent="1">
