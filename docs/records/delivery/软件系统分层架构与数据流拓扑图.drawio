  <diagram id="vessel-layup-arch-bw-clean" name="软件系统分层架构与数据流拓扑图(纯黑白深度排版优化版)">
    <mxGraphModel dx="1250" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="780" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

