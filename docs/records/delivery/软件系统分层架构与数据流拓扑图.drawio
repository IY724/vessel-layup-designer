        <mxCell id="flow_export" value="传递设计方案与计算数据" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=10.5;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei,SimSun,sans-serif;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
