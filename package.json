{
  "name": "vessel-layup-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "复合材料气瓶缠绕铺层设计软件 — 网格理论筒身设计 + 封头缠绕规律校核，纯前端单文件可分发",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE_FILE=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
